@page "/recipe/{id:int}"
@inject HttpClient Http
@inject AuthenticationStateProvider Auth
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components
@using System.Security.Claims
@using System.Globalization
@using RecipeBookProject.Contracts.Recipes
@using RecipeBookProject.Client.Models
@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger">@_errorMessage</div>
}
else if (_loading)
{
    <div>Yükleniyor…</div>
}
else if (product is not null)
{
    <div class="container my-3 my-lg-4">

        @if (!string.IsNullOrEmpty(_infoMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @_infoMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
            </div>
        }

        <!-- === KART: SOLDA RESİM / SAĞDA DETAY === -->
        <div class="card mb-4">
            <div class="row g-0 align-items-stretch">
                <!-- SOL: GÖRSEL -->
                <div class="col-md-5 col-lg-4">
                    <img class="w-100 h-100 object-fit-cover rounded-start min-h-260"
                         src="@product.ImageUrl" alt="@product.ProductName">
                </div>

                <!-- SAĞ: BAŞLIK + BUTONLAR + METİN + PUANLAMA -->
                <div class="col-md-7 col-lg-8">
                    <!-- h-100 ve d-flex flex-column ile tüm yüksekliği kullan -->
                    <div class="h-100 p-3 p-lg-4 d-flex flex-column">

                        <!-- ÜST: Başlık ve ikonlar -->
                        <div>
                            <div class="d-flex align-items-start">
                                <h1 class="h2 mb-0 me-auto">@product.ProductName</h1>

                                <!-- Kısayol ikonları -->
                                <div class="d-flex gap-2 ms-3">
                                    <button class="btn btn-light rounded-circle shadow-sm icon-btn"
                                            title="@(_saved ? "Kaydedildi" : "Kaydet")"
                                            @onclick="ToggleSave">
                                        <i class="@(_saved ? "bi bi-bookmark-fill" : "bi bi-bookmark") fs-5"></i>
                                    </button>

                                    <button class="btn btn-light rounded-circle shadow-sm icon-btn"
                                            title="Tarifi Şikayet Et"
                                            data-bs-toggle="modal" data-bs-target="#reportModal">
                                        <i class="bi bi-flag fs-5"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="text-body mt-3 mb-4">@((MarkupString)product.ProductDetailedText)</div>
                        </div>

                        <!-- ALT: PUANLAMA, flex ile alta itiliyor -->
                        <div class="mt-auto d-flex align-items-center flex-wrap gap-2">
                            <span class="fw-semibold me-1">Puanla:</span>
                            @for (var i = 1; i <= 5; i++)
                            {
                                var star = i;
                                var filled = ((hoverRating ?? userRating) >= star);

                                <i class="@(filled ? "bi bi-star-fill" : "bi bi-star") fs-4 star"
                                   role="button" tabindex="0"
                                   @onmouseover="() => hoverRating = star"
                                   @onmouseout="() => hoverRating = null"
                                   @onclick="() => SetRating(star)"></i>
                            }

                            <small class="text-muted ms-2">
                                Ortalama: @avgRating.ToString("0.0") / 5 (@totalVotes oy)
                            </small>
                            @if (hasRated)
                            {
                                <span class="badge bg-success-subtle text-success ms-2">
                                    Puanınız: @userRating
                                </span>
                            }
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- === MALZEMELER === -->
        @if (product != null)
        {
            <div class="card mb-4">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <div>
                        <i class="bi bi-list-check me-2"></i>
                        Malzemeler 
                        @if (product.Ingredients?.Count > 0)
                        {
                            <span class="text-muted">(@product.Ingredients.Count malzeme)</span>
                        }
                        else
                        {
                            <span class="text-muted">(Malzeme bulunamadı)</span>
                        }
                        <div class="mt-1">
                            <small class="text-muted">
                                <i class="bi bi-info-circle me-1"></i>
                                Porsiyon sayısını değiştirerek malzeme miktarlarını otomatik hesaplayabilirsiniz
                            </small>
                        </div>
                    </div>
                    
                    <!-- Porsiyon Seçici -->
                    <div class="d-flex align-items-center gap-3">
                        <small class="text-muted">Porsiyon:</small>
                        
                        <!-- Hızlı Porsiyon Seçenekleri -->
                        <div class="d-flex gap-1 me-2">
                            @foreach (var quickSize in new[] { 1, 2, 4, 6, 8, 10 })
                            {
                                var isActive = selectedServingSize == quickSize;
                                <button type="button" 
                                        class="btn btn-sm @(isActive ? "btn-primary" : "btn-outline-secondary")"
                                        @onclick="() => SetQuickServingSize(quickSize)"
                                        title="@quickSize kişilik">
                                    @quickSize
                                </button>
                            }
                        </div>
                        
                        <div class="input-group" style="width: 180px;">
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => ChangeServingSize(-1)" disabled="@(selectedServingSize <= 1)">
                                <i class="bi bi-dash"></i>
                            </button>
                            <InputNumber class="form-control form-control-sm text-center" @bind-Value="selectedServingSize" min="1" max="50" @onchange="OnServingSizeChanged" />
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => ChangeServingSize(1)" disabled="@(selectedServingSize >= 50)">
                                <i class="bi bi-plus"></i>
                            </button>
                            <span class="input-group-text">kişi</span>
                        </div>
                        <small class="text-muted">Orijinal: @(product.BaseServingSize) kişilik</small>
                    </div>
                </div>

                <div class="card-body">
                    @if (product.Ingredients?.Count > 0)
                    {
                        <div class="row">
                            @foreach (var ingredient in product.Ingredients)
                            {
                                var scaledQuantity = CalculateScaledQuantity(ingredient.Quantity, product.BaseServingSize, selectedServingSize);
                                var isScaled = selectedServingSize != product.BaseServingSize;
                                <div class="col-md-6 col-lg-4 mb-3">
                                    <div class="ingredient-card p-3 border rounded h-100 @(isScaled ? "scaled-ingredient" : "")" 
                                         style="transition: all 0.3s ease; @(isScaled ? "border-color: #28a745 !important; background-color: #f8fff9;" : "")">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h6 class="mb-0 fw-semibold text-primary">@ingredient.IngredientName</h6>
                                            <div class="text-end">
                                                <span class="badge @(isScaled ? "bg-success" : "bg-primary") rounded-pill fs-6">
                                                    @scaledQuantity.ToString("0.##") @ingredient.Unit
                                                </span>
                                                @if (isScaled)
                                                {
                                                    <div class="mt-1">
                                                        <small class="text-muted">
                                                            <i class="bi bi-arrow-up-right text-success"></i>
                                                            Orijinal: @ingredient.Quantity @ingredient.Unit
                                                        </small>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                        @if (!string.IsNullOrEmpty(ingredient.Notes))
                                        {
                                            <small class="text-muted d-block">
                                                <i class="bi bi-info-circle me-1"></i>
                                                @ingredient.Notes
                                            </small>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-exclamation-triangle text-warning" style="font-size: 3rem;"></i>
                            <h5 class="mt-3 text-muted">Malzeme Bulunamadı</h5>
                            <p class="text-muted">Bu tarif için henüz malzeme eklenmemiş.</p>
                        </div>
                    }

                    <!-- Porsiyon Özeti -->
                    <div class="mt-4 p-4 bg-gradient-light rounded border">
                        <div class="row text-center">
                            <div class="col-4">
                                <div class="fw-bold text-primary fs-4">@product.BaseServingSize</div>
                                <small class="text-muted">
                                    <i class="bi bi-people me-1"></i>
                                    Orijinal Porsiyon
                                </small>
                            </div>
                            <div class="col-4">
                                <div class="fw-bold text-success fs-4">@selectedServingSize</div>
                                <small class="text-muted">
                                    <i class="bi bi-person-check me-1"></i>
                                    Seçilen Porsiyon
                                </small>
                            </div>
                            <div class="col-4">
                                <div class="fw-bold text-info fs-4">@(GetScalingFactor(product.BaseServingSize, selectedServingSize).ToString("0.##"))x</div>
                                <small class="text-muted">
                                    <i class="bi bi-calculator me-1"></i>
                                    Çarpan
                                </small>
                            </div>
                        </div>
                        
                        @if (selectedServingSize != product.BaseServingSize)
                        {
                            <div class="mt-3 pt-3 border-top text-center">
                                @if (product.Ingredients?.Count > 0)
                                {
                                    <div class="alert alert-info mb-0 py-2">
                                        <i class="bi bi-info-circle me-2"></i>
                                        <strong>@selectedServingSize kişilik</strong> için malzeme miktarları otomatik olarak hesaplandı
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-warning mb-0 py-2">
                                        <i class="bi bi-exclamation-triangle me-2"></i>
                                        <strong>@selectedServingSize kişilik</strong> için porsiyon ayarlandı (malzeme bulunamadı)
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- === YORUMLAR === -->
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between">
                <div>
                    <i class="bi bi-chat-dots me-2"></i>
                    Yorumlar <span class="text-muted">(@totalComments)</span>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <small class="text-muted">Göster:</small>
                    <select class="form-select form-select-sm w-auto"
                            @onchange="ChangePageSize">
                        <option value="5" selected="@(pageSize == 5)">5</option>
                        <option value="10" selected="@(pageSize == 10)">10</option>
                        <option value="20" selected="@(pageSize == 20)">20</option>
                        <option value="50" selected="@(pageSize == 50)">50</option>
                    </select>
                </div>
            </div>

            <div class="card-body">
                @if (commentsLoading)
                {
                    <div class="text-muted">Yorumlar yükleniyor…</div>
                }
                else if (comments.Count == 0)
                {
                    <div class="text-muted">Bu tarife henüz yorum yapılmamış. İlk yorumu sen yaz! ✍️</div>
                }
                else
                {
                    <div class="vstack gap-3">
                        @foreach (var c in comments)
                        {
                            <div class="border rounded p-3">
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <strong>@(string.IsNullOrWhiteSpace(c.Name) ? "Anonim" : c.Name)</strong>
                                    <small class="text-muted">@c.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                                </div>
                                <div>@c.Text</div>
                            </div>
                        }
                    </div>

                    <!-- Alt bilgi + sayfalama -->
                    <div class="d-flex align-items-center justify-content-between mt-3">
                        <small class="text-muted">
                            Gösterilen @shownFrom–@shownTo / @totalComments
                        </small>

                        @if (totalPages > 1)
                        {
                            <nav aria-label="Yorum sayfalama">
                                <ul class="pagination mb-0">
                                    <li class="page-item @(currentPage == 1 ? "disabled" : null)">
                                        <button type="button" class="page-link"
                                                @onclick="() => GoToPage(currentPage - 1)">
                                            Önceki
                                        </button>
                                    </li>

                                    @foreach (var p in VisiblePages())
                                    {
                                        if (p == -1)
                                        {
                                            <li class="page-item disabled"><span class="page-link">…</span></li>
                                        }
                                        else
                                        {
                                            <li class="page-item @(p == currentPage ? "active" : null)">
                                                <button type="button" class="page-link"
                                                        @onclick="() => GoToPage(p)">
                                                    @p
                                                </button>
                                            </li>
                                        }
                                    }

                                    <li class="page-item @(currentPage == totalPages ? "disabled" : null)">
                                        <button type="button" class="page-link"
                                                @onclick="() => GoToPage(currentPage + 1)">
                                            Sonraki
                                        </button>
                                    </li>
                                </ul>
                            </nav>
                        }
                    </div>
                }

                <hr class="my-4" />

                <!-- Yorum Ekle -->
                <EditForm Model="@newComment" OnValidSubmit="@AddComment">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <div class="row g-2">
                        <div class="col-md-3">
                            <InputCheckbox class="form-check-input" @bind-Value="newComment.Secret" id="chkAnon" />
                            <label class="form-check-label" for="chkAnon">Adımı gizle</label>
                            @if (!newComment.Secret){
                            <div class="form-control">@usera?.FindFirst(ClaimTypes.Name)?.Value @usera?.FindFirst(ClaimTypes.Surname)?.Value</div>
                            }
                            else{
                        <div class="form-control">@FirstInitial(usera?.FindFirst(ClaimTypes.Name)?.Value). @FirstInitial(@usera?.FindFirst(ClaimTypes.Surname)?.Value).</div>
                            }
                        </div>
                        <div class="col-md-9">
                            <InputTextArea class="form-control" rows="3" @bind-Value="newComment.Text" placeholder="Yorumunuz" />
                        </div>
                    </div>
                    <div class="d-flex justify-content-end mt-2">
                        <button class="btn btn-primary" type="submit">
                            <i class="bi bi-send me-1"></i> Gönder
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>

    <!-- === ŞİKAYET MODAL === -->
    <div class="modal fade" id="reportModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-flag me-2 text-danger"></i>Tarifi Şikayet Et</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>

                <EditForm Model="@report" OnValidSubmit="@SubmitReport">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Gerekçe</label>

                                <InputRadioGroup @bind-Value="report.Reason">
                                @foreach (var item in abuseCategories)
                                {
                                    <div class="form-check">
                                        <InputRadio class="form-check-input" Value=@item.CategoryId />
                                        <label class="form-check-label">@item.CategoryName</label>
                                    </div>
                                }
@*                                     <div class="form-check">
                                        <InputRadio class="form-check-input" Value=@("Uygunsuz / rahatsız edici") />
                                        <label class="form-check-label">Uygunsuz / rahatsız edici</label>
                                    </div>
                                    <div class="form-check">
                                        <InputRadio class="form-check-input" Value=@("Telif / ihlal") />
                                        <label class="form-check-label">Telif / hak ihlali</label>
                                    </div>
                                    <div class="form-check">
                                        <InputRadio class="form-check-input" Value=@("Spam / Reklam") />
                                        <label class="form-check-label">Spam / reklam</label> *@
                                    @* </div> *@
                                </InputRadioGroup>
                       

                        </div>

                        <div class="mb-3">
                            <label class="form-label">Açıklama (opsiyonel)</label>
                            <InputTextArea class="form-control" rows="3" @bind-Value="report.Details" />
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                        <button type="submit" class="btn btn-danger" data-bs-dismiss="modal">
                            <i class="bi bi-flag me-1"></i> Gönder
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int id { get; set; }

    private string? _errorMessage;
    private string? _infoMessage;
    private ProductDto? product;
    private bool _loading;

    // Kaydet
    private bool _saved;

    // Puanlama
    private int userRating = 0;
    private int? hoverRating = null;
    private bool hasRated = false;
    private int totalVotes = 0;          
    private double ratingSum = 28 * 4.4;  
    private double avgRating = 0;

    // Yorumlar
    private List<CommentVm> comments = new();
    private NewCommentVm newComment = new();

    private bool commentsLoading;
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalComments = 0;

    private int totalPages => totalComments == 0 ? 0 : (int)Math.Ceiling(totalComments / (double)pageSize);
    private int shownFrom => totalComments == 0 ? 0 : (currentPage - 1) * pageSize + 1;
    private int shownTo => Math.Min(currentPage * pageSize, totalComments);


    // Şikayet
    private ReportVm report = new();
    private List<AbuseCategoryDto> abuseCategories = new();
    ClaimsPrincipal? usera;

    // Malzemeler ve Porsiyon
    private int selectedServingSize = 1;
    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _errorMessage = null;
        _infoMessage = null;
        product = null;

        try
        {
            var detail = await Http.GetFromJsonAsync<ApiResponse<ProductDto>>($"api/Recipe/GetDetailedRecipe/{id}");
            if (detail is null || !detail.IsSuccess || detail.Data is null)
            {
                _errorMessage = detail?.Message ?? "Kayıt bulunamadı.";
            }
            else
            {
                product = detail.Data;
                selectedServingSize = product.BaseServingSize; // Porsiyon sayısını başlat
                await LoadCommentsAsync(1);
                await LoadSavedRecipe();
                await LoadVotedRecipe();
                await LoadAbuseCategory();
                usera = (await Auth.GetAuthenticationStateAsync()).User;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "İstek sırasında hata: " + ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadSavedRecipe()
    {
        StateHasChanged();

        var res = await Http.GetFromJsonAsync<ApiResponse<bool>>(
        $"api/Recipe/getsavedrecipe?recipeId={id}");

        if (res?.IsSuccess == true)
        {
            _saved = res.Data;
        }
        else
        {
            _saved = false;
        }
    }

    private async Task LoadAbuseCategory()
    {
        StateHasChanged();
        var res = await Http.GetFromJsonAsync<ApiResponse<List<AbuseCategoryDto>>>(
        $"api/Recipe/getabusecategory");
        if (res?.IsSuccess == true)
        {
            abuseCategories = res.Data ?? new();
        }
        else
        {
            _infoMessage = "Şikayet kategorileri yüklenemedi.";
        }
    }

    private async Task LoadVotedRecipe()
    {
        StateHasChanged();

        var res = await Http.GetFromJsonAsync<ApiResponse<VoteRecipeDto>>(
                 $"api/Recipe/getvotedrecipe?recipeId={id}");

        if (res?.IsSuccess == true)
        {
            userRating = res.Data.vote;
            hasRated = userRating > 0;

            totalVotes = res.Data.totalVoters;
            avgRating = res.Data.avgVote; 

            ratingSum = totalVotes > 0 ? avgRating * totalVotes : 0;
        }
        else
        {
            _infoMessage = "Bu tarif için henüz oy verileri yüklenemedi.";
        }
    }
    private static string FirstInitial(string? s)
    {
        if (string.IsNullOrWhiteSpace(s)) return "";
        var ci = new CultureInfo("tr-TR");
        var ch = s.Trim()[0];
        return char.ToUpper(ch, ci).ToString();
    }

    // Malzeme hesaplama metodları
    private decimal CalculateScaledQuantity(decimal originalQuantity, int originalServingSize, int newServingSize)
    {
        if (originalServingSize <= 0) return originalQuantity;
        
        var scalingFactor = (decimal)newServingSize / originalServingSize;
        return originalQuantity * scalingFactor;
    }

    private decimal GetScalingFactor(int originalServingSize, int newServingSize)
    {
        if (originalServingSize <= 0) return 1;
        return (decimal)newServingSize / originalServingSize;
    }

    private void OnServingSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var newSize) && newSize > 0)
        {
            selectedServingSize = newSize;
            StateHasChanged(); // UI'ı güncelle
        }
    }

    private void ChangeServingSize(int delta)
    {
        var newSize = selectedServingSize + delta;
        if (newSize >= 1 && newSize <= 50)
        {
            selectedServingSize = newSize;
            StateHasChanged(); // UI'ı güncelle
        }
    }

    private void SetQuickServingSize(int size)
    {
        if (size >= 1 && size <= 50)
        {
            selectedServingSize = size;
            StateHasChanged(); // UI'ı güncelle
        }
    }

    private async Task LoadCommentsAsync(int page)
    {
        commentsLoading = true;
        StateHasChanged();

        if (page < 1) page = 1;

        try
        {
            var res = await Http.GetFromJsonAsync<ApiResponse<PagedResult<CommentDto>>>(
            $"api/Recipe/{id}/comments?page={page}&pageSize={pageSize}&sort=new");

            if (res?.IsSuccess == true && res.Data is not null)
            {
                currentPage = res.Data.Page;
                pageSize = res.Data.PageSize;
                totalComments = res.Data.TotalCount;

                comments = res.Data.Items.Select(c => new CommentVm
                {
                    Name = c.UserDisplayName,
                    Text = c.Text,
                    CreatedAt = c.CreatedAt
                }).ToList();
            }
            else
            {
                comments.Clear();
                totalComments = 0;
            }
        }
        finally
        {
            commentsLoading = false;
        }
    }

    private async Task GoToPage(int page)
    {
        if (totalPages == 0 && page != 1) return;

        page = Math.Max(1, Math.Min(totalPages > 0 ? totalPages : 1, page));
        await LoadCommentsAsync(page);
    }

    private async Task ChangePageSize(ChangeEventArgs e)
    {
        if (int.TryParse(Convert.ToString(e.Value), out var newSize) && newSize > 0)
        {
            pageSize = newSize;
            await LoadCommentsAsync(1); 
        }
    }

    private IEnumerable<int> VisiblePages()
    {
        if (totalPages <= 7)
        {
            return Enumerable.Range(1, totalPages);
        }

        var window = 1; 
        var pages = new List<int>();

        pages.Add(1);
        if (currentPage > 2 + window) pages.Add(-1);

        var start = Math.Max(2, currentPage - window);
        var end = Math.Min(totalPages - 1, currentPage + window);
        for (int p = start; p <= end; p++) pages.Add(p);

        if (currentPage < totalPages - 1 - window) pages.Add(-1);
        pages.Add(totalPages);

        return pages;
    }


    private void ToggleSave()
    {
        _saved = !_saved;
        _infoMessage = _saved ? "Tarif kaydedildi." : "Kaydedilenlerden çıkarıldı.";
        var saveResponse = Http.PostAsJsonAsync($"api/recipe/save-recipe", new { productid = id, isSaved = _saved });
    }

    private async Task SetRating(int value)
    {
        var v = Math.Min(5, Math.Max(1, value));
        hoverRating = null;

        if (!hasRated)
        {
            hasRated = true;
            totalVotes++;
            ratingSum += v;
        }
        else
        {
            ratingSum -= userRating;
            ratingSum += v;
        }

        userRating = v;

        avgRating = totalVotes == 0 ? 0 : ratingSum / totalVotes;

        await Http.PostAsJsonAsync($"api/recipe/vote-recipe", new { productid = id, vote = v });

        _infoMessage = $"Puanınız kaydedildi: {userRating}/5";
    }

    private async Task AddComment()
    {
        await Http.PostAsJsonAsync($"api/recipe/{id}/comments", new { isSecret=newComment.Secret, commentText=newComment.Text });

        newComment = new();
        _infoMessage = "Yorumunuz eklendi.";

        await LoadCommentsAsync(1);
    }

    private async Task SubmitReport()
    {
        if (report.Reason is null)
        {
            _infoMessage = "Lütfen bir şikayet gerekçesi seçin.";
            return;
        }

        int abuseId = report.Reason is int i ? i
                     : int.TryParse(report.Reason?.ToString(), out var tmp) ? tmp
                     : -1;
        if (abuseId < 0)
        {
            _infoMessage = "Geçersiz gerekçe.";
            return;
        }

        var payload = new AbuseRequestDto
        {
            ProductId = id,
            AbuseCategoryId = abuseId,
            Description = report.Details ?? ""
        };

        try
        {
            var resp = await Http.PostAsJsonAsync("api/recipe/saveabuse", payload);

            if (resp.IsSuccessStatusCode)
            {
                _infoMessage = "Şikayetiniz alındı. Teşekkürler.";
                report = new(); 
            }
            else
            {
                var body = await resp.Content.ReadAsStringAsync();
                _infoMessage = $"Hata: {(int)resp.StatusCode} - {body}";
            }
        }
        catch (Exception ex)
        {
            _infoMessage = $"İstek gönderilemedi: {ex.Message}";
        }
    }

    class CommentVm
    {
        public string? Name { get; set; }
        public string Text { get; set; } = "";
        public DateTime CreatedAt { get; set; } = DateTime.Now;
    }

    class NewCommentVm
    {
        [MaxLength(50)]
        public string? Name { get; set; }

        [Required, MinLength(2), MaxLength(1000)]
        public string Text { get; set; } = "";
        public bool Secret { get; set; } = false;
    }

    class ReportVm
    {
        [Required]
        public int? Reason { get; set; }
        public string? Details { get; set; }
    }
}

